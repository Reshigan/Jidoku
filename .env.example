JIDOKA_DB_URL=sqlite:///./jidoka.db
ANTHROPIC_API_KEY=sk-ant-...        # agent service
SF_TENANT_BASE=https://apiXX.successfactors.eu
SF_OAUTH_CLIENT=vault:kom-sf-dev    # never plaintext secrets in .env for real tenants

# --- OIDC (production identity). Set JIDOKA_OIDC_ISSUER to switch off dev tokens entirely:
# once these are set, /auth/token refuses to mint and only IdP-signed JWTs are accepted.
# None of these are secrets — this API verifies tokens, it never holds a client secret.
JIDOKA_OIDC_ISSUER=                 # e.g. https://login.microsoftonline.com/<tenant-id>/v2.0
JIDOKA_OIDC_AUDIENCE=               # the app/client ID this API is registered as
JIDOKA_OIDC_JWKS_URL=               # optional; defaults to <issuer>/.well-known/jwks.json. HTTPS only.
JIDOKA_OIDC_GROUPS_CLAIM=groups     # claim holding IdP groups (Okta often uses "groups")
# IdP group -> JIDOKA roles. No hardcoded group IDs anywhere in the code; this is the whole mapping.
# A group granting builder AND approve is refused at startup (invariant 7: builder is never approver).
JIDOKA_OIDC_GROUP_MAP={"11111111-...":["builder"],"22222222-...":["approver"]}
